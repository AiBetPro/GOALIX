generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BetStatus { PENDING WON LOST VOID }
enum TransactionType { DEPOSIT BET WIN REFUND }

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  balance      Decimal       @default(10000) @db.Decimal(18,2)
  currency     String        @default("XOF")
  createdAt    DateTime      @default(now())
  bets         Bet[]
  transactions Transaction[]
}

model Bet {
  id           String       @id @default(cuid())
  userId       String
  stake        Decimal      @db.Decimal(18,2)
  totalOdds    Decimal      @db.Decimal(12,4)
  potentialWin Decimal      @db.Decimal(18,2)
  status       BetStatus    @default(PENDING)
  createdAt    DateTime     @default(now())
  user         User         @relation(fields:[userId], references:[id])
  selections   BetSelection[]
  @@index([userId, createdAt])
}

model BetSelection {
  id        String  @id @default(cuid())
  betId     String
  matchId   String
  label     String
  market    String
  odd       Decimal @db.Decimal(12,4)
  bet       Bet     @relation(fields:[betId], references:[id], onDelete: Cascade)
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  type      TransactionType
  amount    Decimal           @db.Decimal(18,2)
  createdAt DateTime          @default(now())
  user      User              @relation(fields:[userId], references:[id])
  @@index([userId, createdAt])
}
